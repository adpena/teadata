# Runtime Python and package resources come from pyproject.toml's package policy.
include LICENSE CITATION.cff README.md AGENTS.md pyproject.toml uv.lock mkdocs.yml .python-version
include scripts/check
recursive-include tests *.py
recursive-include tests/fixtures/tapr_dictionary *.html
recursive-include tests/fixtures/publisher_golden_2025 *.csv *.md
recursive-include tests/fixtures/tefa *.json
recursive-include tests/fixtures/spatial *.json
recursive-include examples *.py
recursive-include docs *.md
recursive-include provenance/records *.json

# Retained data bundles and raw inputs travel separately from Python packages.
prune data
prune teadata/data
prune .cache
prune teadata/.cache
prune provenance/objects
prune .local
prune .venv
prune build
prune dist
global-exclude __pycache__ *.py[cod] *.pkl *.pkl.gz *.pickle *.sqlite* *.db *.parquet
global-exclude *.so *.pyd *.dll *.dylib *.exe .DS_Store
global-exclude .env .env.* *.key *.pem *.pfx *.p12 *.secrets*
